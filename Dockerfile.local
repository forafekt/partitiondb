FROM alpine:3.22 AS certificates
RUN apk add --no-cache openssl

FROM python:3.12-slim AS build
WORKDIR /build
COPY pyproject.toml README.md LICENSE ./
COPY src ./src
RUN pip wheel --no-deps --wheel-dir /wheels .

FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    DJANGO_SETTINGS_MODULE=config.settings_local \
    PYTHONPATH=/app/tests/django_project
WORKDIR /app
COPY --from=build /wheels /wheels
RUN pip install --no-cache-dir '/wheels/'*.whl 'Django>=6.0,<6.1' \
    'psycopg[binary]>=3.2,<4' 'celery[redis]>=5.6,<5.7' 'gunicorn>=23,<24' \
    && rm -rf /wheels && useradd --uid 10001 --create-home app
COPY tests/django_project ./tests/django_project
COPY docker/local ./docker/local
USER 10001:10001
EXPOSE 8000
CMD ["gunicorn", "config.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "2", "--access-logfile", "-", "--error-logfile", "-"]
